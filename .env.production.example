# Docker Compose
POSTGRES_DB=xon_hospital
POSTGRES_USER=xon
POSTGRES_PASSWORD=generate-a-long-random-password

# Payload / Next.js
PAYLOAD_SECRET=generate-a-long-random-secret
CRON_SECRET=generate-a-different-random-secret
PREVIEW_SECRET=generate-another-random-secret
PAYLOAD_DB_PUSH=true
NEXT_PUBLIC_SERVER_URL=https://xonhospital.uz
SITE_CANONICAL_URL=https://xonhospital.uz

# Caddy. Until DNS is connected, use http://SERVER_IP as SITE_ADDRESS.
SITE_ADDRESS=xonhospital.uz, www.xonhospital.uz
ACME_EMAIL=admin@xonhospital.uz

# Optional lead integrations
GOOGLE_SHEETS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
