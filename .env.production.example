# Docker Compose
POSTGRES_DB=xon_hospital
POSTGRES_USER=xon
POSTGRES_PASSWORD=generate-a-long-random-password

# Payload / Next.js
PAYLOAD_SECRET=generate-a-long-random-secret
CRON_SECRET=generate-a-different-random-secret
PREVIEW_SECRET=generate-another-random-secret
PAYLOAD_DB_PUSH=false
NEXT_PUBLIC_SERVER_URL=https://xon-hospital.uz
SITE_CANONICAL_URL=https://xon-hospital.uz

# Caddy. Until DNS is connected, use http://SERVER_IP as SITE_ADDRESS.
SITE_ADDRESS=xon-hospital.uz
WWW_SITE_ADDRESS=www.xon-hospital.uz
CANONICAL_ORIGIN=https://xon-hospital.uz
# Optional: temporarily allow this public IP to register the first CMS owner.
ADMIN_SETUP_IP=127.0.0.1

# Optional lead integrations
GOOGLE_SHEETS_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_LEADS_CHAT_ID=
