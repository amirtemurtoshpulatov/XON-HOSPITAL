{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Limit first-account registration while the user table is empty.
	@firstAdminOutsideSetup {
		path /api/users/first-register /api/users/first-register/ /admin/create-first-user /admin/create-first-user/
		not remote_ip {$ADMIN_SETUP_IP:127.0.0.1}
	}
	respond @firstAdminOutsideSetup 403

	# Google Search Console verification for the /ru/ URL-prefix property.
	handle /ru/google0160f4bd915f0982.html {
		header Content-Type "text/html; charset=utf-8"
		respond "google-site-verification: google0160f4bd915f0982.html" 200
	}

	reverse_proxy web:3000
}

{$WWW_SITE_ADDRESS:localhost} {
	redir {$CANONICAL_ORIGIN:http://localhost}{uri} permanent
}
